PORT=3000
APP_ORIGIN=http://localhost:3000
# Both Google values enable sign-in. The key is also required for Calendar connections.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate a 32-byte key with: openssl rand -hex 32
KOVA_TOKEN_KEY=
# Optional public HTTPS URL ending in /webhooks/google
GOOGLE_WEBHOOK_URL=
# Explicit opt-in for standalone local evaluation; loopback only.
KOVA_LOCAL_MODE=0
